# Directus API (see ../api-e-wedding)
NUXT_DIRECTUS_URL=http://localhost:8055
# Static token of the "Frontend" Directus user, printed by api-e-wedding/scripts/setup.mjs
NUXT_DIRECTUS_TOKEN=

# Optional: public address for link-preview images, e.g. https://wedding.example.com
# (empty = the address each request came in on)
NUXT_SITE_URL=
